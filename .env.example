# Server-only lead capture settings. Add these in Vercel Project Settings > Environment Variables.
# Do NOT prefix secrets with VITE_; VITE_ variables are exposed to the browser.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=crich_construction
MONGODB_COLLECTION_NAME=leads
MONGODB_TRAFFIC_COLLECTION_NAME=traffic_events
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-admin-token

# Resend email notification settings.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
LEAD_NOTIFICATION_TO=info@crichconstructions.com
LEAD_NOTIFICATION_FROM=Crich Constructions <leads@crichconstructions.com>
