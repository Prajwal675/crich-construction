# PRODUCTION: Only expose variables prefixed with VITE_. Do NOT put secrets or private keys here.
VITE_FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID_HERE

# Server-side only (used by /api/contact.ts serverless function).
# Do NOT prefix these with VITE_ - that would bundle them into client JS and leak credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=crich
